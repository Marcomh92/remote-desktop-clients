+	private static void OnPointerEventNew(long inst, byte[] andMask, byte[] xorMask,
+	                                      int width, int height, int xorBpp,
+	                                      int lengthAndMask, int lengthXorMask,
+	                                      int hotspotX, int hotspotY)
+	{
+		SessionState s = GlobalApp.getSession(inst);
+		if (s == null)
+			return;
+		UIEventListener uiEventListener = s.getUIEventListener();
+		if (uiEventListener != null)
+			uiEventListener.OnPointerEventNew(andMask, xorMask, width, height,
+			                                  xorBpp, lengthAndMask, lengthXorMask,
+			                                  hotspotX, hotspotY);
+	}
+
+	private static void OnPointerEventSet(long inst, byte[] andMask, byte[] xorMask,
+	                                      int width, int height, int xorBpp,
+	                                      int lengthAndMask, int lengthXorMask,
+	                                      int hotspotX, int hotspotY)
+	{
+		SessionState s = GlobalApp.getSession(inst);
+		if (s == null)
+			return;
+		UIEventListener uiEventListener = s.getUIEventListener();
+		if (uiEventListener != null)
+			uiEventListener.OnPointerEventSet(andMask, xorMask, width, height,
+			                                  xorBpp, lengthAndMask, lengthXorMask,
+			                                  hotspotX, hotspotY);
+	}
+
+	private static void OnPointerEventSetPosition(long inst, int x, int y)
+	{
+		SessionState s = GlobalApp.getSession(inst);
+		if (s == null)
+			return;
+		UIEventListener uiEventListener = s.getUIEventListener();
+		if (uiEventListener != null)
+			uiEventListener.OnPointerEventSetPosition(x, y);
+	}
+
+	private static void OnPointerEventHide(long inst)
+	{
+		SessionState s = GlobalApp.getSession(inst);
+		if (s == null)
+			return;
+		UIEventListener uiEventListener = s.getUIEventListener();
+		if (uiEventListener != null)
+			uiEventListener.OnPointerEventHide();
+	}
+
+	private static void OnPointerEventDefault(long inst)
+	{
+		SessionState s = GlobalApp.getSession(inst);
+		if (s == null)
+			return;
+		UIEventListener uiEventListener = s.getUIEventListener();
+		if (uiEventListener != null)
+			uiEventListener.OnPointerEventDefault();
+	}
+
 	public static String getVersion()
 	{
 		return freerdp_get_version();
@@ -652,5 +712,19 @@
 		void OnGraphicsResize(int width, int height, int bpp);
 
 		void OnRemoteClipboardChanged(String data);
+
+		// Default methods (Java 8+) so existing UIEventListener implementors
+		// (e.g. SessionActivity) don't have to be touched. Static dispatchers in
+		// LibFreeRDP still call through these and forward to a real implementor
+		// via uiEventListener, so default-empty is safe — the only implementor
+		// that does anything is remoteClientLib/RdpCommunicator.
+		default void OnPointerEventNew(byte[] andMask, byte[] xorMask, int width,
+		                               int height, int xorBpp, int lengthAndMask,
+		                               int lengthXorMask, int hotspotX, int hotspotY) {}
+
+		default void OnPointerEventSet(byte[] andMask, byte[] xorMask, int width,
+		                               int height, int xorBpp, int lengthAndMask,
+		                               int lengthXorMask, int hotspotX, int hotspotY) {}
+
+		default void OnPointerEventSetPosition(int x, int y) {}
+
+		default void OnPointerEventHide() {}
+
+		default void OnPointerEventDefault() {}
 	}
